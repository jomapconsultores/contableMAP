# --- Supabase -------------------------------------------------------------
# URL del proyecto y clave pública (llegan al navegador).
NEXT_PUBLIC_SUPABASE_URL=https://aghnegcsdmfurctfdjsh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio: salta RLS. Solo en el servidor, nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (Ollama) ---------------------------------------------------------
# Extracción de documentos, clasificación de gastos e interpretación de voz.
# Ollama corre en el ThinkPad de la malla Tailscale; el servidor lo alcanza
# por su IP de Tailscale. Todas son opcionales: estos son los valores por
# defecto.
# OLLAMA_URL=http://100.78.16.15:11434
# Modelo para estructurar, clasificar e interpretar la voz.
# OLLAMA_MODEL=gemma4:26b
# Modelo que transcribe las páginas escaneadas; debe admitir imágenes.
# OLLAMA_VISION_MODEL=gemma4:26b
# Ventana de contexto, en tokens.
# OLLAMA_NUM_CTX=32768

# --- Facturación electrónica (SRI) ----------------------------------------
# Cifra la contraseña del certificado .p12 antes de guardarla (AES-256-GCM).
# Sin esta variable no se puede cargar el certificado ni firmar comprobantes,
# y si cambia deja de poder descifrarse la contraseña ya guardada: hay que
# volver a subir el certificado. Mínimo 16 caracteres, distinta por entorno.
SRI_CERT_SECRET=

# Integración con el Gestor Tributario (tributos-web): factura los honorarios de
# Marco Antonio por /api/integracion/facturas. Sin token, esa ruta responde 503.
INTEGRACION_TOKEN=
# RUC de la entidad que emite esas facturas (si tributos-web no lo manda).
INTEGRACION_ENTIDAD_RUC=
