# ---------------------------------------------------------------------------
# Supabase self-hosted · variables del stack
#
# Genera los valores marcados con «(generado)» con:
#     node deploy/supabase/generar-claves.mjs
#
# Este archivo es la plantilla. El .env real NO se versiona: lleva la clave que
# permite firmar tokens de service_role, es decir, saltarse todas las políticas
# RLS de la contabilidad.
# ---------------------------------------------------------------------------

# --- Dónde viven los datos -------------------------------------------------
# Dos discos, dos destinos, medidos en el servidor:
#
#   sda  38 GB, local, 33 GB libres  → la base. Docker se movió al Volume, así
#                                      que este disco está casi vacío y es el
#                                      más rápido: lo que importa para el WAL.
#   sdb  80 GB, Volume, 38 GB libres → los archivos y los respaldos. Es lo que
#                                      crece sin techo y lo que se amplía en
#                                      caliente sin apagar nada.
DIR_DB=/var/lib/contable/supabase/db
DIR_STORAGE=/mnt/HC_Volume_106171631/contable/storage

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=            # (generado)

# --- Claves ----------------------------------------------------------------
JWT_SECRET=                   # (generado) mínimo 32 caracteres
JWT_EXPIRY=3600
ANON_KEY=                     # (generado) JWT con role=anon
SERVICE_ROLE_KEY=             # (generado) JWT con role=service_role

# --- Direcciones -----------------------------------------------------------
# Host público del stack de Supabase. Necesita registro DNS apuntando al
# servidor, en modo solo-DNS hasta que Let's Encrypt emita el certificado.
SUPABASE_HOST=supabase.pensamiento-libre.org
API_EXTERNAL_URL=https://supabase.pensamiento-libre.org

# Origen de la aplicación. Es el único valor admitido por CORS y el destino de
# las redirecciones de correo.
SITE_URL=https://map.pensamiento-libre.org
ADDITIONAL_REDIRECT_URLS=https://map.pensamiento-libre.org/**

# --- Altas y correo --------------------------------------------------------
# La pantalla de acceso permite registrarse. Con los usuarios ya migrados,
# ponlo en "true" para que nadie pueda darse de alta por su cuenta.
DISABLE_SIGNUP=false

# Sin SMTP no hay correo de confirmación: si esto fuera "false", un alta nueva
# quedaría bloqueada sin poder confirmarse.
ENABLE_EMAIL_AUTOCONFIRM=true

SMTP_ADMIN_EMAIL=jomapconsultores@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=ContableMAP
